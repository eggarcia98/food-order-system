{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            // "source.organizeImports": "explicit"
        }
    },
    "isort.args": ["--profile", "black"],
    "[svelte]": {
        "editor.defaultFormatter": "svelte.svelte-vscode"
    },
    "[xml]": {
        "editor.defaultFormatter": "fabianlauer.vs-code-xml-format"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.accessibilitySupport": "off",
    "editor.cursorStyle": "underline",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.fontFamily": "'Google Sans Code'",
    "editor.fontLigatures": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.glyphMargin": false,
    "editor.guides.indentation": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.inlineSuggest.enabled": true,
    "editor.matchBrackets": "never",
    "editor.minimap.enabled": false,
    "editor.overviewRulerBorder": false,
    "editor.scrollbar.vertical": "hidden",
    "editor.stickyScroll.enabled": true,
    "editor.tokenColorCustomizations": {
        "[*Light*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#000"
                    }
                }
            ]
        },
        "[*Dark*]": {
            "textMateRules": [
                {
                    "scope": "ref.matchtext",
                    "settings": {
                        "foreground": "#fff"
                    }
                }
            ]
        },
        "textMateRules": [
            {
                "name": "One Dark italic",
                "scope": [
                    "comment",
                    "entity.other.attribute-name",
                    "keyword",
                    "markup.underline.link",
                    "storage.modifier",
                    "storage.type",
                    "string.url",
                    "variable.language.super",
                    "variable.language.this",
                    "string.printf.placeholder"
                ],
                
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "name": "One Dark italic reset",
                "scope": [
                    "keyword.operator",
                    "keyword.other.type",
                    "storage.modifier.import",
                    "storage.modifier.package",
                    "storage.type.built-in",
                    "storage.type.function.arrow",
                    "storage.type.generic",
                    "storage.type.java",
                    "storage.type.primitive",
                    "support.type.object.console.tsx"

                ],
                "settings": {
                    "fontStyle": ""
                }
            }
        ]
    },
    "files.associations": {
        ".env": "bat"
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 250,
    "github.copilot.enable": {
        "*": true,
        "javascript": true,
        "markdown": false,
        "plaintext": false,
        "typescript": true,
        "yaml": false
    },
    "indenticator.color.dark": "rgba(255, 255, 255, 0.1)",
    "indenticator.width": 0.1,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "liveServer.settings.donotShowInfoMsg": true,
    "material-icon-theme.activeIconPack": "none",
    "polacode.target": "snippet",
    "prettier.tabWidth": 4,
    "rapidapi.terminalLink.enabled": false,
    "redhat.telemetry.enabled": true,
    "remote.SSH.remotePlatform": {
        "aws-my-firs-instance": "linux"
    },
    "screencastMode.mouseIndicatorColor": "#03EFEA",
    "svelte.enable-ts-plugin": true,
    "svelte.plugin.svelte.note-new-transformation": false,
    "symbols.hidesExplorerArrows": false,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.env.osx": {
        "FIG_NEW_SESSION": "1"
    },
    "terminal.integrated.fontFamily": "'Google Sans Code', 'Hack', 'Fira Code iScript', Consolas, 'Courier New', monospace",
    "terminal.integrated.fontSize": 11,
    "typescript.format.insertSpaceAfterTypeAssertion": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "vscodeGoogleTranslate.preferredLanguage": "English",
    "workbench.colorTheme": "One Dark Pro Mix",
    "workbench.editor.showTabs": "single",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.sideBar.location": "right",
    "terminal.integrated.inheritEnv": false,
    "dart.flutterSdkPath": "/Users/egarcia/flutter",
    "dart.openDevTools": "flutter",
    "vsicons.dontShowNewVersionMessage": true,
    "isort.check": true,
    "isort.importStrategy": "fromEnvironment",
    "codetogether.userName": "Erick",
    "editor.codeActionsOnSave": {},
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.wordWrap": "on",
    "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.fontWeight": "100",
    "terminal.integrated.letterSpacing": 2,
    "terminal.integrated.fontWeightBold": "200",
    "editor.fontWeight": "100",
    "editor.fontVariations": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "docker.extension.enableComposeLanguageServer": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "chat.viewSessions.orientation": "stacked",
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    }
}
