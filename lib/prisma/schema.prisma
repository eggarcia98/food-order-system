generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id             Int          @id @default(autoincrement())
  first_name     String       @db.VarChar(100)
  last_name      String       @db.VarChar(100)
  phone_number   String       @unique @db.VarChar(20)
  nationality_id Int?
  created_at     DateTime?    @default(now()) @db.Timestamptz(6)
  nationality    Nationality? @relation(fields: [nationality_id], references: [id], onUpdate: NoAction)
  orders         Order[]

  @@map("customer")
}

model Order {
  id                      Int                       @id @default(autoincrement())
  order_code              String                    @unique @db.VarChar(50)
  customer_id             Int?
  comments                String?
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  status_id               Int?                      @default(1)
  is_info_sent            Boolean?                  @default(false)
  fulfillment_type_id     Int?                      @db.SmallInt
  arrival_from            DateTime?                 @db.Timestamp(6)
  arrival_to              DateTime?                 @db.Timestamp(6)
  customer_note           String?
  customer_confirmed_at   DateTime?                 @db.Timestamp(6)
  fulfillment_type        FulfillmentType?          @relation(fields: [fulfillment_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_fulfillment_type")
  customer                Customer?                 @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status                  Status?                   @relation(fields: [status_id], references: [id], onDelete: Cascade, map: "order_status_fk")
  order_confirmation_link order_confirmation_link[]
  order_item_extras       OrderItemExtras[]
  order_items             OrderItems[]

  @@map("order")
}

model OrderItems {
  id          Int         @id @default(autoincrement())
  order_id    Int
  variant_id  Int
  quantity    Int         @default(1)
  unit_price  Decimal     @db.Decimal(10, 2)
  Order       Order       @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ItemVariant ItemVariant @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_items")
}

model OrderItemExtras {
  id         Int        @id @default(autoincrement())
  order_id   Int
  extra_id   Int
  quantity   Int        @default(1)
  unit_price Decimal    @db.Decimal(10, 2)
  MenuExtras MenuExtras @relation(fields: [extra_id], references: [extra_id], onDelete: NoAction, onUpdate: NoAction)
  Order      Order      @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("order_item_extras")
}

model MenuItems {
  id            Int           @id @default(autoincrement())
  category_id   Int?          @default(1)
  name          String        @db.VarChar(100)
  description   String?
  img_url       String?
  is_active     Boolean?      @default(true)
  item_variants ItemVariant[]
  categories    categories?   @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("menu_items")
}

model ItemVariant {
  id            Int             @id @default(autoincrement())
  item_id       Int?
  variant_name  String?         @db.VarChar(100)
  price         Decimal         @db.Decimal(10, 2)
  is_active     Boolean?        @default(true)
  MenuItem      MenuItems?      @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrderItems    OrderItems[]
  price_history price_history[]

  @@map("item_variants")
}

model MenuExtras {
  extra_id        Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  price           Decimal           @db.Decimal(10, 2)
  is_active       Boolean?          @default(true)
  OrderItemExtras OrderItemExtras[]
  price_history   price_history[]

  @@map("menu_extras")
}

model Nationality {
  id       Int        @id @default(autoincrement())
  name     String     @db.VarChar(100)
  customer Customer[]

  @@map("nationality")
}

model Status {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  Order Order[]

  @@map("status")
}

model FulfillmentType {
  id    Int     @id @default(autoincrement()) @db.SmallInt
  name  String  @unique @db.VarChar(30)
  Order Order[]

  @@map("fulfillment_type")
}

model business_locations {
  location_id           Int     @id @default(autoincrement())
  name                  String? @db.VarChar(100)
  address               String?
  suburb_state_postcode String? @db.VarChar(100)
  hours_of_operation    String?
  phone_number          String? @db.VarChar(20)
  social_handle         String? @db.VarChar(50)
}

model categories {
  category_id   Int         @id @default(autoincrement())
  category_name String      @db.VarChar(50)
  menu_items    MenuItems[]
}

model dish {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(150)
  cost       Decimal   @db.Decimal(10, 2)
  price      Decimal   @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model price_history {
  history_id        Int          @id @default(autoincrement())
  variant_id        Int?
  extra_id          Int?
  old_price         Decimal?     @db.Decimal(10, 2)
  new_price         Decimal      @db.Decimal(10, 2)
  change_date       DateTime?    @default(now()) @db.Timestamp(6)
  changed_by        String?      @default("system_user") @db.VarChar(50)
  reason_for_change String?
  menu_extras       MenuExtras?  @relation(fields: [extra_id], references: [extra_id], onDelete: NoAction, onUpdate: NoAction)
  item_variants     ItemVariant? @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model side {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  cost        Decimal   @db.Decimal(10, 2)
  price       Decimal   @db.Decimal(10, 2)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model view_log {
  id                Int      @id @default(autoincrement())
  user_id           Int?
  model             String   @db.VarChar(16)
  model_id          Int
  timestamp         DateTime @db.Timestamptz(6)
  metadata          String?
  has_access        Boolean?
  context           String?  @db.VarChar(32)
  embedding_client  String?  @db.VarChar(254)
  embedding_version String?  @db.VarChar(254)

  @@index([model_id], map: "idx_view_log_model_id")
  @@index([timestamp], map: "idx_view_log_timestamp")
  @@index([user_id], map: "idx_view_log_user_id")
}

model order_confirmation_link {
  id         Int       @id @default(autoincrement())
  order_id   Int
  token      String    @unique(map: "uq_order_confirmation_link_token") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expires_at DateTime  @db.Timestamp(6)
  used_at    DateTime? @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  order      Order     @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_confirmation_link_order")
}
